# ---------------------------------------------------------------------------
# Sofia Mo — environment variables
# Copy to `.env.local` and fill in. Never commit a filled-in file.
# Every value below is optional: the site builds and runs with all of them
# empty, degrading to documented fallbacks (see README section "Fallbacks").
# ---------------------------------------------------------------------------

# --- YouTube ---------------------------------------------------------------
# Data API v3 key. Without it the site uses the RSS feed, then /src/content/videos.ts.
YOUTUBE_API_KEY=
# Channel ID, the UC... form. Required for both the API and the RSS fallback.
YOUTUBE_CHANNEL_ID=
# Uploads playlist ID (UU... form). Optional: saves one API call per revalidation.
YOUTUBE_UPLOADS_PLAYLIST_ID=

# --- Contact form ----------------------------------------------------------
# Resend API key. Without it, submissions are validated and logged but not emailed.
RESEND_API_KEY=
# Where enquiry notifications are delivered.
CONTACT_TO_EMAIL=
# Verified Resend sender. Must be on a domain verified in the Resend dashboard.
CONTACT_FROM_EMAIL=

# --- Site ------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs and structured data.
NEXT_PUBLIC_SITE_URL=https://sofiamo.com
# Plausible domain, e.g. sofiamo.com. Empty disables the analytics script;
# events still no-op safely.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
